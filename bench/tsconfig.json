{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["convex/**/*.ts", "shared/**/*.ts", "runner/**/*.ts"],
  "exclude": ["convex/_generated", "convex/rust"]
}
