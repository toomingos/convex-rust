(module
 (import "convex" "task_submit" (func $submit (param i32 i32) (result i64)))
 (import "convex" "task_poll" (func $poll (param i32) (result i64)))
 (import "convex" "sync_syscall" (func $sync (param i32 i32 i32 i32) (result i64)))
 (import "convex" "log" (func $log (param i32 i32 i32)))
 (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
 (import "wasi_snapshot_preview1" "fd_close" (func $fd_close (param i32) (result i32)))
 (memory (export "memory") 32)
 (global $brk (mut i32) (i32.const 8192))
 (data (i32.const 256) "\7b\22\6f\6b\22\3a\5b")
(data (i32.const 271) "\7b\22\6f\6b\22\3a")
(data (i32.const 285) "\5d\7d")
(data (i32.const 295) "\7b\22\6f\6b\22\3a\22\73\75\62\6d\69\74\2d\66\61\69\6c\65\64\22\7d")
(data (i32.const 325) "\55\6e\63\61\75\67\68\74\20\70\61\6e\69\63\3a\20\62\6f\6f\6d\20\61\74\20\73\72\63\2f\78\2e\72\73\3a\31\3a\32")
(data (i32.const 369) "\7b\22\65\72\72\6f\72\22\3a\7b\22\6d\65\73\73\61\67\65\22\3a\22\62\61\64\22\2c\22\6b\69\6e\64\22\3a\22\75\73\65\72\22\7d\7d")
(data (i32.const 418) "\7b\22\65\72\72\6f\72\22\3a\7b\22\6d\65\73\73\61\67\65\22\3a\22\63\78\22\2c\22\6b\69\6e\64\22\3a\22\63\6f\6e\76\65\78\22\2c\22\64\61\74\61\22\3a\7b\22\63\6f\64\65\22\3a\34\32\7d\7d\7d")
(data (i32.const 487) "\6e\6f\74\20\6a\73\6f\6e")
(data (i32.const 503) "\7b\22\78\22\3a\31\7d")
(data (i32.const 518) "\6e\6f\77")
(data (i32.const 529) "\7b\7d")
(data (i32.const 539) "\6f\75\74\31\0a\70\61\72\74\69\61\6c")
(data (i32.const 559) "\65\72\72\31\0a")
(data (i32.const 572) "\7b\22\6f\6b\22\3a\74\72\75\65\7d")
(data (i32.const 591) "\7b\22\6f\6b\22\3a\66\61\6c\73\65\7d")
(data (i32.const 611) "\7b\22\6f\6b\22\3a\35\32\7d")
(data (i32.const 628) "\7b\22\6f\6b\22\3a\2d\31\7d")
(data (i32.const 645) "\7b\22\6f\6b\22\3a\22\78\22\7d")
(data (i32.const 663) "\63\6f\6d\70\6f\6e\65\6e\74\41\72\67\75\6d\65\6e\74")
(data (i32.const 688) "\7b\22\6e\61\6d\65\22\3a\22\6b\22\7d")

 (func (export "_initialize") (i32.store8 (i32.const 100) (i32.const 1)))
 (func $alloc (export "convex_alloc") (param $n i32) (result i32) (local $p i32)
  (local.set $p (global.get $brk))
  (global.set $brk (i32.add (global.get $brk) (i32.and (i32.add (local.get $n) (i32.const 7)) (i32.const -8))))
  (local.get $p))
 (func $pack (param $p i32) (param $l i32) (result i64)
  (i64.or (i64.shl (i64.extend_i32_u (local.get $p)) (i64.const 32)) (i64.extend_i32_u (local.get $l))))
 ;; {"ok":<body>} -> packed
 (func $wrap (param $p i32) (param $l i32) (result i64) (local $o i32)
  (local.set $o (call $alloc (i32.add (local.get $l) (i32.const 7))))
  (memory.copy (local.get $o) (i32.const 271) (i32.const 6))
  (memory.copy (i32.add (local.get $o) (i32.const 6)) (local.get $p) (local.get $l))
  (i32.store8 (i32.add (local.get $o) (i32.add (i32.const 6) (local.get $l))) (i32.const 125))
  (call $pack (local.get $o) (i32.add (local.get $l) (i32.const 7))))
 (func (export "convex_run:t::echo") (param $p i32) (param $l i32) (result i64)
  (call $wrap (local.get $p) (local.get $l)))
 (func (export "convex_run:t::inited") (param $p i32) (param $l i32) (result i64)
  (if (result i64) (i32.load8_u (i32.const 100)) (then (call $pack (i32.const 572) (i32.const 11))) (else (call $pack (i32.const 591) (i32.const 12)))))
 ;; submits the args as a task request, then drains events until none are outstanding
 (func (export "convex_run:t::proxy") (param $p i32) (param $l i32) (result i64)
  (local $id i64) (local $out i32) (local $w i32) (local $ev i64) (local $ep i32) (local $el i32) (local $first i32)
  (local.set $first (i32.const 1))
  (local.set $out (call $alloc (i32.const 262144)))
  (local.set $w (local.get $out))
  (local.set $id (call $submit (local.get $p) (local.get $l)))
  (if (i64.lt_s (local.get $id) (i64.const 0)) (then (return (call $pack (i32.const 295) (i32.const 22)))))
  (memory.copy (local.get $w) (i32.const 256) (i32.const 7))
  (local.set $w (i32.add (local.get $w) (i32.const 7)))
  (block $done
   (loop $l
    (local.set $ev (call $poll (i32.const 1)))
    (br_if $done (i64.eq (local.get $ev) (i64.const -1)))
    (local.set $ep (i32.wrap_i64 (i64.shr_u (local.get $ev) (i64.const 32))))
    (local.set $el (i32.wrap_i64 (local.get $ev)))
    (if (local.get $first)
     (then (local.set $first (i32.const 0)))
     (else (i32.store8 (local.get $w) (i32.const 44)) (local.set $w (i32.add (local.get $w) (i32.const 1)))))
    (memory.copy (local.get $w) (local.get $ep) (local.get $el))
    (local.set $w (i32.add (local.get $w) (local.get $el)))
    (br $l)))
  (memory.copy (local.get $w) (i32.const 285) (i32.const 2))
  (local.set $w (i32.add (local.get $w) (i32.const 2)))
  (call $pack (local.get $out) (i32.sub (local.get $w) (local.get $out))))
 ;; poll(0) with nothing queued, then poll(1) with nothing outstanding
 (func (export "convex_run:t::idle") (param $p i32) (param $l i32) (result i64)
  (local $a i64) (local $b i64)
  (local.set $a (call $poll (i32.const 0)))
  (local.set $b (call $poll (i32.const 1)))
  (if (result i64) (i32.and (i64.eq (local.get $a) (i64.const 0)) (i64.eq (local.get $b) (i64.const -1)))
   (then (call $pack (i32.const 572) (i32.const 11))) (else (call $pack (i32.const 591) (i32.const 12)))))
 (func (export "convex_run:t::sync") (param $p i32) (param $l i32) (result i64) (local $r i64)
  (local.set $r (call $sync (i32.const 518) (i32.const 3) (i32.const 529) (i32.const 2)))
  (call $wrap (i32.wrap_i64 (i64.shr_u (local.get $r) (i64.const 32))) (i32.wrap_i64 (local.get $r))))
 (func (export "convex_run:t::syncunknown") (param $p i32) (param $l i32) (result i64) (local $r i64)
  (local.set $r (call $sync (i32.const 529) (i32.const 2) (i32.const 529) (i32.const 2)))
  (call $wrap (i32.wrap_i64 (i64.shr_u (local.get $r) (i64.const 32))) (i32.wrap_i64 (local.get $r))))
 (func (export "convex_run:t::synccomp") (param $p i32) (param $l i32) (result i64) (local $r i64)
  (local.set $r (call $sync (i32.const 663) (i32.const 17) (i32.const 688) (i32.const 12)))
  (call $wrap (i32.wrap_i64 (i64.shr_u (local.get $r) (i64.const 32))) (i32.wrap_i64 (local.get $r))))
 (func (export "convex_run:t::panic") (param $p i32) (param $l i32) (result i64)
  (call $log (i32.const 1) (i32.const 539) (i32.const 12))
  (call $log (i32.const 3) (i32.const 325) (i32.const 36))
  unreachable)
 (func (export "convex_run:t::trap") (param $p i32) (param $l i32) (result i64) unreachable)
 (func (export "convex_run:t::err") (param $p i32) (param $l i32) (result i64) (call $pack (i32.const 369) (i32.const 41)))
 (func (export "convex_run:t::cerr") (param $p i32) (param $l i32) (result i64) (call $pack (i32.const 418) (i32.const 61)))
 (func (export "convex_run:t::notjson") (param $p i32) (param $l i32) (result i64) (call $pack (i32.const 487) (i32.const 8)))
 (func (export "convex_run:t::neither") (param $p i32) (param $l i32) (result i64) (call $pack (i32.const 503) (i32.const 7)))
 (func (export "convex_run:t::print") (param $p i32) (param $l i32) (result i64)
  (call $log (i32.const 0) (i32.const 518) (i32.const 3))
  (call $log (i32.const 1) (i32.const 518) (i32.const 3))
  (call $log (i32.const 2) (i32.const 518) (i32.const 3))
  (i32.store (i32.const 3000) (i32.const 539))
  (i32.store (i32.const 3004) (i32.const 12))
  (drop (call $fd_write (i32.const 1) (i32.const 3000) (i32.const 1) (i32.const 3100)))
  (i32.store (i32.const 3008) (i32.const 559))
  (i32.store (i32.const 3012) (i32.const 5))
  (drop (call $fd_write (i32.const 2) (i32.const 3008) (i32.const 1) (i32.const 3100)))
  (call $pack (i32.const 572) (i32.const 11)))
 (func (export "convex_run:t::enosys") (param $p i32) (param $l i32) (result i64)
  (if (result i64) (i32.eq (call $fd_close (i32.const 3)) (i32.const 52)) (then (call $pack (i32.const 611) (i32.const 9))) (else (call $pack (i32.const 628) (i32.const 9)))))
)
