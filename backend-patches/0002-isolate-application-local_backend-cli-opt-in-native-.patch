+        assert_eq!(fn_names(&m), ["hello", "secret"]);
+        let m = analyze_one(&cfg_linux(), "rust/other.js", carrier(&bytes, &map)).unwrap();
+        assert_eq!(fn_names(&m), ["x"]);
+    }
