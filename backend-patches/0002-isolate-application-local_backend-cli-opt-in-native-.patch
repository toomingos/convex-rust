+
+    fn frames_dir() -> PathBuf {
+        let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+        // crates/isolate -> convex-backend -> vendor -> convex-rs
+        let p = root.join("../../../../contracts/native/frames");
+        if p.is_dir() {
+            return p;
