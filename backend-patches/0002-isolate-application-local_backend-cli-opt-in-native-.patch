+        let bytes = build_elf(&ElfSpec::new(EM_AARCH64, syms));
+        assert_err(
+            analyze_one(&cfg_linux(), "rust/hello.js", carrier(&bytes, &map)),
+            "invalid `convex:manifest` entry",
+        );
+    }
