+/// The contents of the worker's `Ready` frame.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReadyInfo {
+    pub pid: u32,
+    pub resolved_exports: u32,
+    pub init_us: u64,
+    pub rss_bytes: u64,
