+        assert_eq!(rec[0], STATUS_OOM);
+        assert_eq!(u64::from_le_bytes(rec[1..9].try_into().unwrap()), 1000);
+        assert_eq!(u64::from_le_bytes(rec[9..17].try_into().unwrap()), 2000);
