+  return {
+    functions: functions.map((f) => ({
+      name: f.name,
+      pos: null,
+      udfType: f.udfType ?? "Query",
+      visibility: { kind: f.visibility ?? "public" },
+      args: f.args ?? null,
+      returns: f.returns ?? null,
+    })),
+    httpRoutes: null,
+    cronSpecs: null,
+    sourceMapped: null,
+  } as any;
+}
