+            }),
+          }),
+        },
+      ]),
+    });
+    expect(out).toContain("pub const r#type: FunctionRef<TypeArgs, Value>");
+    expect(out).toContain(
+      '#[serde(rename = "my-field")]\n        pub my_field: String,',
+    );
+    expect(out).toContain(
