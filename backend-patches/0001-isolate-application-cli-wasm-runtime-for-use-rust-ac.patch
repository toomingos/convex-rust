+            r#"{{"abiVersion":{abi},"modulePath":"{module_path}","name":"{fname}","visibility":"{vis}","args":null,"returns":null}}"#
+        )
+    }
+
+    fn config(path: &str, bytes: &[u8]) -> ModuleConfig {
