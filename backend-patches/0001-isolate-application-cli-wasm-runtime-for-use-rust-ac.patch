+  const exec: Exec = (cmd, args) => {
+    if (cmd === "rustup" && args[0] === "target" && args[1] === "add") {
+      installed = true;
+      return ok();
+    }
+    if (cmd === "rustup" && args[0] === "target")
+      return ok(installed ? "wasm32-wasip1\n" : "");
+    return ok();
+  };
+  resetToolchainCache();
+  const dir = toolchainDir();
