+                assert_eq!(r, json!({"ok": true}), "{alg}");
+                let (r, ..) = run(
+                    "crypto/verify",
+                    json!({"alg": alg}),
+                    &[("key", &d(public)), ("msg", b"other"), ("sig", &sig)],
+                );
+                assert_eq!(r, json!({"ok": false}), "{alg} wrong msg");
+            }
+        }
+    }
