+    pub backend: B,
+}
+
+#[derive(Debug)]
+pub enum GuestResult {
+    /// The raw JSON of the `ok` field (already validated as JSON).
+    Ok(Box<RawValue>),
+    Error {
+        message: String,
+        data: Option<JsonValue>,
+        kind: GuestErrorKind,
+    },
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum GuestErrorKind {
+    Convex,
+    Panic,
+    User,
+}
+
+#[derive(Debug)]
+pub enum CallFailure {
+    /// The guest ran past the user timeout.
+    Timeout,
+    /// Trap (unreachable, OOM, out-of-bounds guest pointer, ...).
+    Trap(String),
+    /// The guest panicked: `message` is `<panic message> at <file:line:col>`
+    /// as reported by its panic hook; `trap` is the wasm trap that followed.
+    Panic { message: String, trap: String },
+    /// The guest broke the ABI (bad envelope, missing exports).
+    Protocol(String),
+    /// The result envelope is larger than the function result size limit.
+    ResultTooLarge { len: usize, max: usize },
+}
+
+pub struct WasmCore<B: HostBackend> {
+    engine: Engine,
+    linker: Linker<Host<B>>,
+    cache: Mutex<LruCache<ModuleHash, Arc<PreparedModule<B>>>>,
+    /// Per-hash compile locks: concurrent `prepare`s of one module compile it
+    /// once.
+    compiling: Mutex<HashMap<ModuleHash, Arc<Mutex<()>>>>,
+    limits: CoreLimits,
+    /// Identifies this wasmtime build + engine config in cache file names.
+    engine_tag: String,
+    stop_ticker: Arc<AtomicBool>,
+}
+
+impl<B: HostBackend> Drop for WasmCore<B> {
+    fn drop(&mut self) {
+        self.stop_ticker.store(true, Ordering::Relaxed);
+    }
+}
+
+impl<B: HostBackend> WasmCore<B> {
+    pub fn new() -> anyhow::Result<Self> {
+        Self::with_limits(CoreLimits::default())
+    }
+
+    pub fn with_limits(limits: CoreLimits) -> anyhow::Result<Self> {
+        let mut cfg = Config::new();
+        cfg.epoch_interruption(true);
+        // The store limiter caps each memory separately, so allow only one.
+        cfg.wasm_multi_memory(false);
+        let engine = Engine::new(&cfg).map_err(werr)?;
+        let engine_tag = {
+            use std::hash::{
+                Hash,
+                Hasher,
+            };
+            // `DefaultHasher::new()` uses fixed keys, so the tag is stable
+            // across processes of one build.
+            let mut h = std::collections::hash_map::DefaultHasher::new();
+            engine.precompile_compatibility_hash().hash(&mut h);
+            format!("{:016x}", h.finish())
+        };
+
+        let mut linker: Linker<Host<B>> = Linker::new(&engine);
+        p1::add_to_linker_async(&mut linker, |h: &mut Host<B>| &mut h.wasi).map_err(werr)?;
+        add_convex_imports(&mut linker).map_err(werr)?;
+
+        let stop_ticker = Arc::new(AtomicBool::new(false));
+        {
+            let engine = engine.clone();
+            let stop = stop_ticker.clone();
+            std::thread::Builder::new()
+                .name("rust-action-epoch".into())
+                .spawn(move || {
+                    while !stop.load(Ordering::Relaxed) {
+                        std::thread::sleep(EPOCH_TICK);
+                        engine.increment_epoch();
+                    }
+                })
+                .context("spawning epoch ticker")?;
+        }
+        Ok(Self {
+            engine,
+            linker,
+            cache: Mutex::new(LruCache::new(
+                NonZeroUsize::new(MODULE_CACHE_CAPACITY).expect("nonzero"),
+            )),
+            compiling: Mutex::new(HashMap::new()),
+            engine_tag,
+            limits,
+            stop_ticker,
+        })
+    }
+
+    /// Looks `wasm` up in the LRU (by sha256) or compiles it. Compilation is
+    /// CPU bound; callers on an async runtime should run this on a blocking
+    /// thread. Concurrent calls for the same module compile it once. A module
+    /// that cannot be used fails with [`InvalidModule`].
+    pub fn prepare(&self, wasm: &[u8]) -> anyhow::Result<Arc<PreparedModule<B>>> {
+        let hash: ModuleHash = Sha256::digest(wasm).into();
+        self.prepare_keyed(hash, || Ok(Cow::Borrowed(wasm)))
+    }
+
+    /// Like [`Self::prepare`] for a base64 module source. The cache is keyed
+    /// by the source text, so a hit skips the decode too.
+    pub fn prepare_base64(&self, source: &str) -> anyhow::Result<Arc<PreparedModule<B>>> {
+        let hash: ModuleHash = Sha256::digest(source.as_bytes()).into();
+        self.prepare_base64_keyed(hash, source)
+    }
+
+    /// Cache hit for `key` (e.g. `ModuleMetadata.sha256`), without touching
+    /// the module source. Callers fetch the source only on a miss.
+    pub fn lookup(&self, key: &ModuleHash) -> Option<Arc<PreparedModule<B>>> {
+        self.cache.lock().get(key).cloned()
+    }
+
+    /// [`Self::prepare_base64`] under a caller-supplied content key.
+    pub fn prepare_base64_keyed(
+        &self,
+        key: ModuleHash,
+        source: &str,
+    ) -> anyhow::Result<Arc<PreparedModule<B>>> {
+        self.prepare_keyed(key, || {
+            base64::decode(source.trim())
+                .map(Cow::Owned)
+                .map_err(|e| invalid(format!("module source is not valid base64: {e}")))
+        })
+    }
+
+    fn prepare_keyed<'a>(
+        &self,
+        hash: ModuleHash,
+        wasm: impl FnOnce() -> anyhow::Result<Cow<'a, [u8]>>,
+    ) -> anyhow::Result<Arc<PreparedModule<B>>> {
+        if let Some(hit) = self.cache.lock().get(&hash) {
+            return Ok(hit.clone());
+        }
+        let lock = self.compiling.lock().entry(hash).or_default().clone();
+        let result = {
+            let _guard = lock.lock();
+            // Someone may have compiled it while we waited.
+            let hit = self.cache.lock().get(&hash).cloned();
+            match hit {
+                Some(hit) => Ok(hit),
+                None => match self.load_from_disk(&hash) {
+                    Some(module) => self.finish(hash, module),
+                    None => wasm().and_then(|wasm| self.compile(hash, &wasm)),
+                },
+            }
+        };
+        self.compiling.lock().remove(&hash);
+        result
+    }
+
+    fn disk_path(&self, hash: &ModuleHash) -> Option<std::path::PathBuf> {
+        let dir = self.limits.disk_cache_dir.as_ref()?;
+        let hex: String = hash.iter().map(|b| format!("{b:02x}")).collect();
+        Some(dir.join(format!("{hex}-{}.cwasm", self.engine_tag)))
+    }
+
+    /// Loads a module we serialized earlier. Any failure is a cache miss.
+    fn load_from_disk(&self, hash: &ModuleHash) -> Option<wasmtime::Module> {
+        let path = self.disk_path(hash)?;
+        if !path.exists() {
+            return None;
+        }
+        // SAFETY: `Module::deserialize_file` trusts the file contents (a
+        // forged artifact is arbitrary code execution) and requires the file
+        // to stay unchanged while mapped. Both hold because (1) files in this
+        // directory are written only by `store_to_disk` below, from modules
+        // that already passed `check_manifest` and `Module::new` in this
+        // process, with the name derived from the content hash and the exact
+        // wasmtime build/config; the directory is under the backend's own
+        // data dir with the same trust as the database; (2) files are
+        // published by atomic rename of a fully written temp file and never
+        // modified in place, so a replaced file leaves the old inode (and any
+        // live mapping) intact. wasmtime additionally rejects artifacts from
+        // another version/config.
+        match unsafe { wasmtime::Module::deserialize_file(&self.engine, &path) } {
+            Ok(m) => Some(m),
+            Err(e) => {
+                tracing::warn!("ignoring unusable wasm cache file {path:?}: {e:#}");
+                None
+            },
+        }
+    }
+
+    fn store_to_disk(&self, hash: &ModuleHash, module: &wasmtime::Module) {
+        let Some(path) = self.disk_path(hash) else {
+            return;
+        };
+        let res = (|| -> anyhow::Result<()> {
+            let bytes = module.serialize().map_err(werr)?;
+            std::fs::create_dir_all(path.parent().context("no parent")?)?;
+            let tmp = path.with_extension(format!("tmp{}-{:?}", std::process::id(), std::thread::current().id()));
+            std::fs::write(&tmp, &bytes)?;
+            std::fs::rename(&tmp, &path).inspect_err(|_| {
+                let _ = std::fs::remove_file(&tmp);
+            })?;
+            Ok(())
+        })();
+        if let Err(e) = res {
+            tracing::warn!("could not write wasm cache file {path:?}: {e:#}");
+        }
+    }
+
+    fn compile(&self, hash: ModuleHash, wasm: &[u8]) -> anyhow::Result<Arc<PreparedModule<B>>> {
+        check_manifest(wasm).map_err(|e| invalid(format!("{e:#}")))?;
+        let module = wasmtime::Module::new(&self.engine, wasm)
+            .map_err(|e| invalid(format!("invalid wasm module: {e:#}")))?;
+        self.store_to_disk(&hash, &module);
+        // Re-map the module from its cache file: outside Linux, wasmtime only
+        // copy-on-write-initializes memory for file-backed modules, so the
+        // in-memory one would copy every data segment on each instantiation.
+        let module = self.load_from_disk(&hash).unwrap_or(module);
+        self.finish(hash, module)
+    }
+
+    /// Reads the exports, links and caches a compiled module.
+    fn finish(
+        &self,
+        hash: ModuleHash,
+        module: wasmtime::Module,
+    ) -> anyhow::Result<Arc<PreparedModule<B>>> {
+        let mut functions = BTreeMap::new();
+        for e in module.exports() {
+            let Some(rest) = e.name().strip_prefix("convex_run:") else {
+                continue;
+            };
+            let (module_path, name) = rest
+                .rsplit_once(':')
+                .ok_or_else(|| invalid(format!("bad export name {}", e.name())))?;
+            // `app::a::b` (Rust `module_path!()`) -> `rust/a/b`; the first
+            // segment is the crate name.
+            let segs: Vec<&str> = module_path.split("::").skip(1).collect();
+            functions.insert(
+                format!("rust/{}:{}", segs.join("/"), name),
+                e.name().to_string(),
+            );
+        }
+        // Unknown imports show up here as link errors.
+        let pre = self
+            .linker
+            .instantiate_pre(&module)
+            .map_err(|e| invalid(format!("unsupported module imports: {e:#}")))?;
+        let prepared = Arc::new(PreparedModule {
+            hash,
+            pre,
+            functions,
+        });
+        self.cache.lock().put(hash, prepared.clone());
+        Ok(prepared)
+    }
+
+    /// Runs one export in a fresh store and instance. `wall_clock` resolves
+    /// when the user timeout has elapsed; it also covers a guest parked on
+    /// `task_poll(block)`, where the epoch hook never fires. On timeout the
+    /// call is abandoned but stdout / stderr are still forwarded.
+    pub async fn call(
+        &self,
+        module: &PreparedModule<B>,
+        export: &str,
+        args_json: &str,
+        env: Vec<(String, String)>,
+        backend: B,
+        timeout: Duration,
+        wall_clock: impl Future<Output = ()>,
+    ) -> CallOutput<B> {
+        let stdout = StdioSink::new(STDIO_CAPACITY);
+        let stderr = StdioSink::new(STDIO_CAPACITY);
+        let mut wasi = WasiCtxBuilder::new();
+        wasi.stdout(stdout.clone()).stderr(stderr.clone());
+        for (k, v) in &env {
+            wasi.env(k, v);
+        }
+        let mut store = Store::new(
+            &self.engine,
+            Host {
+                wasi: wasi.build_p1(),
+                limits: StoreLimitsBuilder::new()
+                    .memory_size(self.limits.memory_bytes)
+                    .memories(1)
+                    .tables(4)
+                    .table_elements(TABLE_ELEMENTS_LIMIT)
+                    .instances(1)
+                    .build(),
+                core_limits: self.limits.clone(),
+                stdout,
+                stderr,
+                backend,
+                panic: None,
+            },
+        );
+        store.limiter(|h| &mut h.limits);
+        let timed_out = Arc::new(AtomicBool::new(false));
+        {
+            let timed_out = timed_out.clone();
+            let start = Instant::now();
+            store.set_epoch_deadline(1);
+            store.epoch_deadline_callback(move |_| {
+                if start.elapsed() >= timeout {
+                    timed_out.store(true, Ordering::Relaxed);
+                    Err(wasmtime::Error::msg("user timeout"))
+                } else {
+                    // Yield so a CPU-bound guest cannot starve the runtime.
+                    Ok(UpdateDeadline::Yield(1))
+                }
+            });
+        }
+
+        let outcome = {
+            let run = run_export(&mut store, &module.pre, export, args_json);
+            futures::pin_mut!(run, wall_clock);
+            match futures::future::select(run, wall_clock).await {
+                Either::Left((outcome, _)) => outcome,
+                Either::Right(((), _)) => {
+                    timed_out.store(true, Ordering::Relaxed);
+                    Err(RunError::Trap("user timeout".into()))
+                },
+            }
+        };
+
+        let mut host = store.into_data();
+        host.flush_stdio(true);
+        let panic = host.panic.take();
+        let result = match outcome {
+            Ok(text) => parse_envelope(&text).map_err(CallFailure::Protocol),
+            Err(RunError::Trap(_)) if timed_out.load(Ordering::Relaxed) => {
+                Err(CallFailure::Timeout)
+            },
+            Err(RunError::Trap(e)) => Err(match panic {
+                Some(message) => CallFailure::Panic { message, trap: e },
+                None => CallFailure::Trap(e),
+            }),
+            Err(RunError::Protocol(e)) => Err(CallFailure::Protocol(e)),
+            Err(RunError::ResultTooLarge { len, max }) => {
+                Err(CallFailure::ResultTooLarge { len, max })
+            },
+        };
+        CallOutput {
+            result,
+            backend: host.backend,
+        }
+    }
+}
+
+enum RunError {
+    Trap(String),
+    Protocol(String),
+    ResultTooLarge { len: usize, max: usize },
+}
+
+async fn run_export<B: HostBackend>(
+    store: &mut Store<Host<B>>,
+    pre: &InstancePre<Host<B>>,
+    export: &str,
+    args: &str,
+) -> Result<String, RunError> {
+    let trap = |e: wasmtime::Error| RunError::Trap(format!("{e:#}"));
+    let proto = |e: wasmtime::Error| RunError::Protocol(format!("{e:#}"));
+    let instance = pre.instantiate_async(&mut *store).await.map_err(trap)?;
+    if let Some(init) = instance.get_func(&mut *store, "_initialize") {
+        let init = init.typed::<(), ()>(&*store).map_err(proto)?;
+        init.call_async(&mut *store, ()).await.map_err(trap)?;
+    }
+    let memory = instance
+        .get_memory(&mut *store, "memory")
+        .ok_or_else(|| RunError::Protocol("module has no `memory` export".into()))?;
+    let alloc = instance
+        .get_typed_func::<i32, i32>(&mut *store, "convex_alloc")
+        .map_err(proto)?;
+    let run = instance
+        .get_typed_func::<(i32, i32), i64>(&mut *store, export)
+        .map_err(proto)?;
+    let len =
+        i32::try_from(args.len()).map_err(|_| RunError::Protocol("arguments too large".into()))?;
+    let ptr = alloc.call_async(&mut *store, len).await.map_err(trap)?;
+    write_memory(&memory, &mut *store, ptr, args.as_bytes()).map_err(trap)?;
+    let packed = run
+        .call_async(&mut *store, (ptr, len))
+        .await
+        .map_err(trap)?;
+    let (rptr, rlen) = unpack(packed);
+    // Check the size before copying anything out of guest memory.
+    let max = store.data().core_limits.max_result_bytes;
+    if rlen as usize > max {
+        return Err(RunError::ResultTooLarge {
+            len: rlen as usize,
+            max,
+        });
+    }
+    let bytes = read_memory(&memory, &*store, rptr, rlen)
+        .map_err(|e| RunError::Protocol(format!("result envelope: {e:#}")))?;
+    String::from_utf8(bytes)
+        .map_err(|e| RunError::Protocol(format!("result envelope is not UTF-8: {e}")))
+}
+
+/// Parses the packed `convex_run` return value (ABI.md "Result envelope").
+pub fn parse_envelope(text: &str) -> Result<GuestResult, String> {
+    let mut v: BTreeMap<String, Box<RawValue>> =
+        serde_json::from_str(text).map_err(|e| format!("guest returned invalid JSON: {e}"))?;
+    if let Some(ok) = v.remove("ok") {
+        return Ok(GuestResult::Ok(ok));
+    }
+    let Some(err) = v.remove("error") else {
+        return Err("result envelope has neither `ok` nor `error`".into());
+    };
+    let err: JsonValue = serde_json::from_str(err.get()).map_err(|e| e.to_string())?;
+    let message = err
+        .get("message")
+        .and_then(JsonValue::as_str)
+        .unwrap_or("unknown error")
+        .to_string();
+    let kind = match err.get("kind").and_then(JsonValue::as_str) {
+        Some("convex") => GuestErrorKind::Convex,
+        Some("panic") => GuestErrorKind::Panic,
+        _ => GuestErrorKind::User,
+    };
+    // `ConvexError(null)` keeps its (null) data, like JS.
+    let data = err
+        .get("data")
+        .filter(|d| !d.is_null() || kind == GuestErrorKind::Convex)
+        .cloned();
+    Ok(GuestResult::Error {
+        message,
+        data,
+        kind,
+    })
+}
+
+pub fn unpack(v: i64) -> (u32, u32) {
+    let v = v as u64;
+    ((v >> 32) as u32, (v & 0xffff_ffff) as u32)
+}
+
+pub fn pack(ptr: u32, len: u32) -> i64 {
+    (((ptr as u64) << 32) | len as u64) as i64
+}
+
+fn werr(e: wasmtime::Error) -> anyhow::Error {
+    anyhow::anyhow!("{e:#}")
+}
+
+fn read_memory(
+    mem: &Memory,
+    store: impl wasmtime::AsContext,
+    ptr: u32,
+    len: u32,
+) -> wasmtime::Result<Vec<u8>> {
+    let start = ptr as usize;
+    let end = start
+        .checked_add(len as usize)
+        .ok_or_else(|| wasmtime::Error::msg("guest pointer out of bounds"))?;
+    mem.data(&store)
+        .get(start..end)
+        .map(<[u8]>::to_vec)
+        .ok_or_else(|| wasmtime::Error::msg("guest pointer out of bounds"))
+}
+
+fn write_memory(
+    mem: &Memory,
+    store: impl wasmtime::AsContextMut,
+    ptr: i32,
+    bytes: &[u8],
+) -> wasmtime::Result<()> {
+    mem.write(store, ptr as u32 as usize, bytes)
+        .map_err(|_| wasmtime::Error::msg("convex_alloc returned an out-of-bounds pointer"))
+}
+
+fn guest_memory<B: HostBackend>(caller: &mut Caller<'_, Host<B>>) -> wasmtime::Result<Memory> {
+    match caller.get_export("memory") {
+        Some(Extern::Memory(m)) => Ok(m),
+        _ => Err(wasmtime::Error::msg("guest has no memory export")),
+    }
+}
+
+fn read_guest<B: HostBackend>(
+    caller: &mut Caller<'_, Host<B>>,
+    ptr: i32,
+    len: i32,
+) -> wasmtime::Result<Vec<u8>> {
+    let mem = guest_memory(caller)?;
+    read_memory(&mem, &*caller, ptr as u32, len as u32)
+}
+
+/// `convex_alloc` handshake: allocate in the guest, copy, return packed
+/// `(ptr << 32) | len`.
+async fn write_guest<B: HostBackend>(
+    caller: &mut Caller<'_, Host<B>>,
+    bytes: &[u8],
+) -> wasmtime::Result<i64> {
+    let alloc = match caller.get_export("convex_alloc") {
+        Some(Extern::Func(f)) => f.typed::<i32, i32>(&*caller)?,
+        _ => return Err(wasmtime::Error::msg("guest has no convex_alloc export")),
+    };
+    let len = u32::try_from(bytes.len())
+        .ok()
+        .filter(|l| *l <= i32::MAX as u32)
+        .ok_or_else(|| wasmtime::Error::msg("host reply too large for guest"))?;
+    let ptr = alloc.call_async(&mut *caller, len as i32).await?;
+    let mem = guest_memory(caller)?;
+    write_memory(&mem, &mut *caller, ptr, bytes)?;
+    Ok(pack(ptr as u32, len))
+}
+
+fn add_convex_imports<B: HostBackend>(linker: &mut Linker<Host<B>>) -> wasmtime::Result<()> {
+    linker.func_wrap(
+        "convex",
+        "task_submit",
+        |mut c: Caller<'_, Host<B>>, ptr: i32, len: i32| -> wasmtime::Result<i64> {
+            let max = c.data().core_limits.max_task_request_bytes;
+            // Reject before touching guest memory.
+            if len as u32 as usize > max {
+                c.data_mut().backend.log(
+                    3,
+                    format!("task_submit: request of {} bytes exceeds {max}", len as u32),
+                );
+                return Ok(-1);
+            }
+            let max_tasks = c.data().core_limits.max_outstanding_tasks;
+            if c.data().backend.outstanding_tasks() >= max_tasks {
+                c.data_mut().backend.log(
+                    3,
+                    format!("task_submit: more than {max_tasks} outstanding tasks"),
+                );
+                return Ok(-1);
+            }
+            let bytes = read_guest(&mut c, ptr, len)?;
+            let req: JsonValue = match serde_json::from_slice(&bytes) {
+                Ok(v) => v,
+                Err(e) => {
+                    c.data_mut()
+                        .backend
+                        .log(3, format!("task_submit: malformed request: {e}"));
+                    return Ok(-1);
+                },
+            };
+            match c.data_mut().backend.submit(req) {
+                Ok(id) => Ok(id),
+                Err(reason) => {
+                    c.data_mut()
+                        .backend
+                        .log(3, format!("task_submit: {reason}"));
+                    Ok(-1)
+                },
+            }
+        },
+    )?;
+
+    linker.func_wrap_async(
+        "convex",
+        "task_poll",
+        |mut c: Caller<'_, Host<B>>, (block,): (i32,)| {
+            Box::new(async move {
+                match c.data_mut().backend.poll(block != 0).await {
+                    PollOutcome::Event(ev) => write_guest(&mut c, ev.as_bytes()).await,
+                    PollOutcome::Empty => Ok(0),
+                    PollOutcome::NoTasks => Ok(-1),
+                }
+            })
+        },
+    )?;
+
+    linker.func_wrap_async(
+        "convex",
+        "sync_syscall",
+        |mut c: Caller<'_, Host<B>>, (op_ptr, op_len, args_ptr, args_len): (i32, i32, i32, i32)| {
+            Box::new(async move {
+                let max = c.data().core_limits.max_task_request_bytes;
+                if op_len as u32 as usize > MAX_OP_NAME_BYTES || args_len as u32 as usize > max {
+                    let reply = serde_json::json!({
+                        "error": {"message": "sync_syscall: request too large"}
+                    });
+                    return write_guest(&mut c, reply.to_string().as_bytes()).await;
+                }
+                let op = String::from_utf8_lossy(&read_guest(&mut c, op_ptr, op_len)?).into_owned();
+                let args_bytes = read_guest(&mut c, args_ptr, args_len)?;
+                let reply = match serde_json::from_slice(&args_bytes) {
+                    Ok(args) => {
+                        // `crypto/*` is served here; it reads guest buffers in place.
+                        let served = if op.starts_with("crypto/") {
+                            let mem = guest_memory(&mut c)?;
+                            let data = mem.data_mut(&mut c);
+                            // Large inputs would stall this tokio worker; hand the
+                            // worker's queue to another thread while hashing.
+                            // (`block_in_place` panics on a current-thread runtime.)
+                            let big = super::host_crypto::input_len(&args) > (1 << 20)
+                                && tokio::runtime::Handle::try_current().is_ok_and(|h| {
+                                    h.runtime_flavor() == tokio::runtime::RuntimeFlavor::MultiThread
+                                });
+                            if big {
+                                tokio::task::block_in_place(|| {
+                                    super::host_crypto::sync_op(&op, &args, data)
+                                })
+                            } else {
+                                super::host_crypto::sync_op(&op, &args, data)
+                            }
+                        } else {
+                            None
+                        };
+                        match served {
+                            Some(reply) => reply,
+                            None => c.data_mut().backend.sync_syscall(&op, args),
+                        }
+                    },
+                    Err(e) => serde_json::json!({
+                        "error": {"message": format!("sync op {op}: invalid args: {e}")}
+                    }),
+                };
+                write_guest(&mut c, reply.to_string().as_bytes()).await
+            })
+        },
+    )?;
+
+    linker.func_wrap(
+        "convex",
+        "log",
+        |mut c: Caller<'_, Host<B>>, level: i32, ptr: i32, len: i32| -> wasmtime::Result<()> {
+            // Never copy more than one log line out of guest memory.
+            let max = c.data().core_limits.max_log_message_bytes;
+            let len = (len as u32 as usize).min(max) as i32;
+            let bytes = read_guest(&mut c, ptr, len)?;
+            let message = truncate_utf8(String::from_utf8_lossy(&bytes).into_owned(), max);
+            // Keep stdout / stderr lines written so far ahead of this one.
+            let host = c.data_mut();
+            host.flush_stdio(false);
+            // Level 4 is the panic marker (`convex_panic_marker` guests): not a
+            // user log line.
+            if level == 4 {
+                return Ok(());
+            }
+            if level == 3
+                && let Some(p) = message.strip_prefix(PANIC_LOG_PREFIX) {
+                    host.panic = Some(p.to_string());
+                }
+            host.backend.log(level, message);
+            Ok(())
+        },
+    )?;
+    Ok(())
+}
+
+/// Parses the `convex:manifest` custom section (contracts/MANIFEST.md) and
+/// checks `abiVersion`.
+fn check_manifest(wasm: &[u8]) -> anyhow::Result<()> {
+    let mut found = 0;
+    for payload in wasmparser::Parser::new(0).parse_all(wasm) {
+        let payload = payload.context("invalid wasm module")?;
+        if let wasmparser::Payload::CustomSection(s) = payload {
+            if s.name() != "convex:manifest" {
+                continue;
+            }
+            for line in std::str::from_utf8(s.data())?
+                .split('\n')
+                .filter(|l| !l.trim().is_empty())
+            {
+                let m: JsonValue =
+                    serde_json::from_str(line).context("bad convex:manifest fragment")?;
+                if m["abiVersion"].as_i64() != Some(ABI_VERSION) {
+                    anyhow::bail!("unsupported abiVersion {}", m["abiVersion"]);
+                }
+                found += 1;
+            }
+        }
+    }
+    anyhow::ensure!(found > 0, "module has no convex:manifest entries");
+    Ok(())
+}
diff --git a/crates/isolate/src/environment/rust/dispatch.rs b/crates/isolate/src/environment/rust/dispatch.rs
new file mode 100644
index 0000000..e1e9ea0
--- /dev/null
+++ b/crates/isolate/src/environment/rust/dispatch.rs
@@ -0,0 +1,122 @@
+//! Entry point for actions run through [`IsolateClient`]: `"use rust"` modules
+//! go to the wasm runtime, everything else to a V8 worker.
+
+use std::sync::Arc;
+
+use common::{
+    execution_context::ExecutionContext,
+    http::fetch::FetchClient,
+    log_lines::LogLine,
+    runtime::Runtime,
+    types::ModuleEnvironment,
+};
+use database::Transaction;
+use common::document::ParsedDocument;
+use model::modules::{
+    types::ModuleMetadata,
+    ModuleModel,
+};
+use tokio::sync::{
+    mpsc,
+    oneshot,
+};
+use udf::{
+    validation::ValidatedPathAndArgs,
+    ActionCallbacks,
+    ActionOutcome,
+};
+
+use crate::{
+    client::{
+        ActionRequest,
+        ActionRequestParams,
+        EnvironmentData,
+    },
+    IsolateClient,
+};
+
+impl<RT: Runtime> IsolateClient<RT> {
+    /// Like [`IsolateClient::execute_action`], but looks up the function's
+    /// module environment first and runs `"use rust"` modules on the wasm
+    /// runtime instead of a V8 worker.
+    #[fastrace::trace]
+    pub async fn execute_action_or_rust(
+        &self,
+        path_and_args: ValidatedPathAndArgs,
+        mut transaction: Transaction<RT>,
+        action_callbacks: Arc<dyn ActionCallbacks>,
+        fetch_client: Arc<dyn FetchClient>,
+        log_line_sender: mpsc::UnboundedSender<LogLine>,
+        context: ExecutionContext,
+        environment_data: EnvironmentData<RT>,
+        instance_name: String,
+        function_started_sender: Option<oneshot::Sender<()>>,
+    ) -> anyhow::Result<ActionOutcome> {
+        // `"use rust"` modules run on the wasm runtime, not a V8 worker.
+        let metadata = ModuleModel::new(&mut transaction)
+            .get_metadata_for_function_by_id(path_and_args.path())
+            .await?;
+        if let Some(metadata) = metadata.filter(|m| m.environment == ModuleEnvironment::Rust) {
+            self.execute_rust_action(
+                metadata,
+                path_and_args,
+                transaction,
+                action_callbacks,
+                fetch_client,
+                log_line_sender,
+                context,
+                environment_data,
+                function_started_sender,
+            )
+            .await
+        } else {
+            self.execute_action(
+                path_and_args,
+                transaction,
+                action_callbacks,
+                fetch_client,
+                log_line_sender,
+                context,
+                environment_data,
+                instance_name,
+                function_started_sender,
+            )
+            .await
+        }
+    }
+
+    /// Execute a `"use rust"` action. Same inputs and outcome as
+    /// [`IsolateClient::execute_action`], but runs on the wasm runtime, not a
+    /// V8 worker.
+    #[fastrace::trace]
+    async fn execute_rust_action(
+        &self,
+        metadata: Arc<ParsedDocument<ModuleMetadata>>,
+        path_and_args: ValidatedPathAndArgs,
+        transaction: Transaction<RT>,
+        action_callbacks: Arc<dyn ActionCallbacks>,
+        fetch_client: Arc<dyn FetchClient>,
+        log_line_sender: mpsc::UnboundedSender<LogLine>,
+        context: ExecutionContext,
+        environment_data: EnvironmentData<RT>,
+        function_started_sender: Option<oneshot::Sender<()>>,
+    ) -> anyhow::Result<ActionOutcome> {
+        let request = ActionRequest {
+            params: ActionRequestParams { path_and_args },
+            identity: transaction.identity().clone(),
+            transaction,
+            context,
+            environment_data,
+        };
+        self.rust_runtime
+            .execute_action(
+                metadata,
+                request,
+                action_callbacks,
+                fetch_client,
+                log_line_sender,
+                function_started_sender,
+            )
+            .await
+    }
+}
diff --git a/crates/isolate/src/environment/rust/host_crypto.rs b/crates/isolate/src/environment/rust/host_crypto.rs
new file mode 100644
index 0000000..098353a
--- /dev/null
+++ b/crates/isolate/src/environment/rust/host_crypto.rs
@@ -0,0 +1,555 @@
+//! Optional `crypto/*` sync ops (contracts/ABI.md "Optional sync ops", crypto
+//! version 2): `crypto/caps`, `crypto/verify`, `crypto/sign`, `crypto/aead`,
+//! `crypto/digest`, `crypto/hmac`, natively on aws-lc-rs. Wasm guests carry no
+//! crypto code of their own; they call these. Served by the wasmtime core
+//! itself, so every `HostBackend` gets it.
+//!
+//! Byte arguments are a base64 string or a `{"ptr", "len"}` reference into the
+//! guest's linear memory, read in place (`crypto/aead` transforms `data` in
+//! place), so large payloads are never copied through JSON.
+
+use std::borrow::Cow;
+
+use aws_lc_rs::{
+    aead::{
+        Aad,
+        LessSafeKey,
+        Nonce,
+        UnboundKey,
+        AES_128_GCM,
+        AES_256_GCM,
+    },
+    digest,
+    hmac,
+    rand::SystemRandom,
+    signature::{
+        EcdsaKeyPair,
+        Ed25519KeyPair,
+        KeyPair,
+        RsaKeyPair,
+        RsaEncoding,
+        UnparsedPublicKey,
+        VerificationAlgorithm,
+        ECDSA_P256_SHA256_FIXED,
+        ECDSA_P256_SHA256_FIXED_SIGNING,
+        ECDSA_P384_SHA384_FIXED,
+        ECDSA_P384_SHA384_FIXED_SIGNING,
+        ED25519,
+        RSA_PKCS1_2048_8192_SHA256,
+        RSA_PKCS1_2048_8192_SHA384,
+        RSA_PKCS1_2048_8192_SHA512,
+        RSA_PKCS1_SHA256,
+        RSA_PKCS1_SHA384,
+        RSA_PKCS1_SHA512,
+        RSA_PSS_2048_8192_SHA256,
+        RSA_PSS_2048_8192_SHA384,
+        RSA_PSS_2048_8192_SHA512,
+        RSA_PSS_SHA256,
+        RSA_PSS_SHA384,
+        RSA_PSS_SHA512,
+    },
+};
+use serde_json::{
+    json,
+    Value as JsonValue,
+};
+
+const VERSION: u64 = 2;
+const SIG_ALGS: [&str; 9] = [
+    "RS256", "RS384", "RS512", "PS256", "PS384", "PS512", "ES256", "ES384", "EdDSA",
+];
+const AEAD_ALGS: [&str; 2] = ["A128GCM", "A256GCM"];
+const DIGEST_ALGS: [&str; 4] = ["SHA-1", "SHA-256", "SHA-384", "SHA-512"];
+const TAG_LEN: usize = 16;
+const NONCE_LEN: usize = 12;
+/// RSA modulus policy, identical on every host (aws-lc-rs limits; the V8 host
+/// enforces the same range).
+const RSA_BITS: std::ops::RangeInclusive<usize> = 2048..=8192;
+
+type Res<T> = Result<T, String>;
+
+fn verify_algorithm(alg: &str) -> Option<&'static dyn VerificationAlgorithm> {
+    Some(match alg {
+        "RS256" => &RSA_PKCS1_2048_8192_SHA256,
+        "RS384" => &RSA_PKCS1_2048_8192_SHA384,
+        "RS512" => &RSA_PKCS1_2048_8192_SHA512,
+        "PS256" => &RSA_PSS_2048_8192_SHA256,
+        "PS384" => &RSA_PSS_2048_8192_SHA384,
+        "PS512" => &RSA_PSS_2048_8192_SHA512,
+        "ES256" => &ECDSA_P256_SHA256_FIXED,
+        "ES384" => &ECDSA_P384_SHA384_FIXED,
+        "EdDSA" => &ED25519,
+        _ => return None,
+    })
+}
+
+fn rsa_padding(alg: &str) -> Option<&'static dyn RsaEncoding> {
+    Some(match alg {
+        "RS256" => &RSA_PKCS1_SHA256,
+        "RS384" => &RSA_PKCS1_SHA384,
+        "RS512" => &RSA_PKCS1_SHA512,
+        "PS256" => &RSA_PSS_SHA256,
+        "PS384" => &RSA_PSS_SHA384,
+        "PS512" => &RSA_PSS_SHA512,
+        _ => return None,
+    })
+}
+
+fn digest_algorithm(alg: &str) -> Option<&'static digest::Algorithm> {
+    Some(match alg {
+        "SHA-1" => &digest::SHA1_FOR_LEGACY_USE_ONLY,
+        "SHA-256" => &digest::SHA256,
+        "SHA-384" => &digest::SHA384,
+        "SHA-512" => &digest::SHA512,
+        _ => return None,
+    })
+}
+
+fn hmac_algorithm(alg: &str) -> Option<hmac::Algorithm> {
+    Some(match alg {
+        "SHA-1" => hmac::HMAC_SHA1_FOR_LEGACY_USE_ONLY,
+        "SHA-256" => hmac::HMAC_SHA256,
+        "SHA-384" => hmac::HMAC_SHA384,
+        "SHA-512" => hmac::HMAC_SHA512,
+        _ => return None,
+    })
+}
+
+/// Bit length of the modulus of a PKCS#1 `RSAPublicKey` DER, or `None` if
+/// malformed.
+fn rsa_modulus_bits(der: &[u8]) -> Option<usize> {
+    fn len(b: &[u8]) -> Option<(usize, &[u8])> {
+        let (&first, rest) = b.split_first()?;
+        if first < 0x80 {
+            return Some((first as usize, rest));
+        }
+        let n = (first & 0x7f) as usize;
+        if n == 0 || n > 4 || rest.len() < n {
+            return None;
+        }
+        let v = rest[..n].iter().fold(0usize, |a, &x| (a << 8) | x as usize);
+        Some((v, &rest[n..]))
+    }
+    let (&tag, rest) = der.split_first()?;
+    if tag != 0x30 {
+        return None;
+    }
+    let (_, rest) = len(rest)?;
+    let (&tag, rest) = rest.split_first()?;
+    if tag != 0x02 {
+        return None;
+    }
+    let (n, rest) = len(rest)?;
+    let m = rest.get(..n)?;
+    let m = &m[m.iter().position(|&b| b != 0)?..];
+    Some((m.len() - 1) * 8 + (8 - m[0].leading_zeros() as usize))
+}
+
+/// Largest `{ptr, len}` argument served inline. The op runs on the async
+/// task and cannot be interrupted by the call's wall-clock limit, so a
+/// guest-chosen length must not be able to pin a thread for long.
+pub const MAX_INPUT_BYTES: usize = 32 << 20;
+
+/// Total length of the `{ptr, len}` arguments of an op (cheap pre-check).
+pub fn input_len(args: &JsonValue) -> usize {
+    args.as_object().map_or(0, |o| {
+        o.values()
+            .filter_map(|v| v.get("len")?.as_u64())
+            .fold(0usize, |a, l| a.saturating_add(l as usize))
+    })
+}
+
+/// A resolved byte argument.
+fn range_of(args: &JsonValue, field: &str, mem_len: usize) -> Option<Res<std::ops::Range<usize>>> {
+    let v = args.get(field)?.as_object()?;
+    let (ptr, len) = (v.get("ptr")?.as_u64()?, v.get("len")?.as_u64()?);
+    let (ptr, len) = (ptr as usize, len as usize);
+    Some(match ptr.checked_add(len) {
+        _ if len > MAX_INPUT_BYTES => Err(format!("{field}: input too large (max {MAX_INPUT_BYTES} bytes)")),
+        Some(end) if end <= mem_len => Ok(ptr..end),
+        _ => Err(format!("{field}: out of bounds")),
+    })
+}
+
+fn bytes<'a>(args: &JsonValue, field: &str, mem: &'a [u8]) -> Res<Cow<'a, [u8]>> {
+    if let Some(r) = range_of(args, field, mem.len()) {
+        return Ok(Cow::Borrowed(&mem[r?]));
+    }
+    let s = args
+        .get(field)
+        .and_then(|v| v.as_str())
+        .ok_or_else(|| format!("missing {field}"))?;
+    base64::decode(s)
+        .map(Cow::Owned)
+        .map_err(|e| format!("bad {field}: {e}"))
+}
+
+fn alg_of<'a>(args: &'a JsonValue) -> Res<&'a str> {
+    args.get("alg")
+        .and_then(|v| v.as_str())
+        .ok_or_else(|| "missing alg".to_string())
+}
+
+fn check_rsa_public(alg: &str, key: &[u8]) -> Res<()> {
+    if alg.starts_with("ES") || alg == "EdDSA" {
+        return Ok(());
+    }
+    match rsa_modulus_bits(key) {
+        Some(b) if RSA_BITS.contains(&b) => Ok(()),
+        Some(b) => Err(format!("unsupported RSA key size {b}")),
+        None => Err("bad RSA key".into()),
+    }
+}
+
+fn verify(args: &JsonValue, mem: &[u8]) -> Res<JsonValue> {
+    let alg = alg_of(args)?;
+    let params = verify_algorithm(alg).ok_or_else(|| format!("unsupported alg {alg}"))?;
+    let (key, msg, sig) = (bytes(args, "key", mem)?, bytes(args, "msg", mem)?, bytes(args, "sig", mem)?);
+    check_rsa_public(alg, &key)?;
+    if alg == "EdDSA" && key.len() != 32 {
+        return Err("bad Ed25519 key".into());
+    }
+    Ok(json!(UnparsedPublicKey::new(params, &*key).verify(&msg, &sig).is_ok()))
+}
+
+fn sign(args: &JsonValue, mem: &[u8]) -> Res<JsonValue> {
+    let alg = alg_of(args)?;
+    let (key, msg) = (bytes(args, "key", mem)?, bytes(args, "msg", mem)?);
+    let rng = SystemRandom::new();
+    let sig: Vec<u8> = match alg {
+        "ES256" | "ES384" => {
+            let signing = if alg == "ES256" {
+                &ECDSA_P256_SHA256_FIXED_SIGNING
+            } else {
+                &ECDSA_P384_SHA384_FIXED_SIGNING
+            };
+            let kp = EcdsaKeyPair::from_pkcs8(signing, &key).map_err(|e| format!("bad key: {e}"))?;
+            kp.sign(&rng, &msg).map_err(|e| e.to_string())?.as_ref().to_vec()
+        },
+        "EdDSA" => {
+            let kp =
+                Ed25519KeyPair::from_pkcs8_maybe_unchecked(&key).map_err(|e| format!("bad key: {e}"))?;
+            kp.sign(&msg).as_ref().to_vec()
+        },
+        _ => {
+            let padding = rsa_padding(alg).ok_or_else(|| format!("unsupported alg {alg}"))?;
+            let kp = RsaKeyPair::from_pkcs8(&key).map_err(|e| format!("bad key: {e}"))?;
+            let bits = kp.public_modulus_len() * 8;
+            if !RSA_BITS.contains(&bits) {
+                return Err(format!("unsupported RSA key size {bits}"));
+            }
+            let mut sig = vec![0u8; kp.public_modulus_len()];
+            kp.sign(padding, &rng, &msg, &mut sig).map_err(|e| e.to_string())?;
+            sig
+        },
+    };
+    Ok(json!(base64::encode(sig)))
+}
+
+fn pubkey(args: &JsonValue, mem: &[u8]) -> Res<JsonValue> {
+    let alg = alg_of(args)?;
+    let key = bytes(args, "key", mem)?;
+    let public: Vec<u8> = match alg {
+        "ES256" | "ES384" => {
+            let signing = if alg == "ES256" {
+                &ECDSA_P256_SHA256_FIXED_SIGNING
+            } else {
+                &ECDSA_P384_SHA384_FIXED_SIGNING
+            };
+            let kp = EcdsaKeyPair::from_pkcs8(signing, &key).map_err(|e| format!("bad key: {e}"))?;
+            kp.public_key().as_ref().to_vec()
+        },
+        "EdDSA" => {
+            let kp =
+                Ed25519KeyPair::from_pkcs8_maybe_unchecked(&key).map_err(|e| format!("bad key: {e}"))?;
+            kp.public_key().as_ref().to_vec()
+        },
+        _ => return Err(format!("unsupported alg {alg}")),
+    };
+    Ok(json!(base64::encode(public)))
+}
+
+fn aead(args: &JsonValue, mem: &mut [u8]) -> Res<JsonValue> {
+    let alg = alg_of(args)?;
+    let algorithm = match alg {
+        "A128GCM" => &AES_128_GCM,
+        "A256GCM" => &AES_256_GCM,
+        _ => return Err(format!("unsupported alg {alg}")),
+    };
+    let dir = args.get("dir").and_then(|v| v.as_str()).unwrap_or_default();
+    let key = bytes(args, "key", mem)?.into_owned();
+    let nonce = bytes(args, "nonce", mem)?.into_owned();
+    let aad = match args.get("aad") {
+        Some(v) if !v.is_null() => bytes(args, "aad", mem)?.into_owned(),
+        _ => Vec::new(),
+    };
+    let tag = if dir == "open" {
+        bytes(args, "tag", mem)?.into_owned()
+    } else {
+        Vec::new()
+    };
+    if nonce.len() != NONCE_LEN {
+        return Err(format!("nonce must be {NONCE_LEN} bytes"));
+    }
+    let key = UnboundKey::new(algorithm, &key)
+        .map(LessSafeKey::new)
+        .map_err(|_| format!("{alg} needs a {}-byte key", algorithm.key_len()))?;
+    let nonce = Nonce::try_assume_unique_for_key(&nonce).map_err(|e| e.to_string())?;
+    let range = range_of(args, "data", mem.len()).ok_or("data must be a memory reference")??;
+    let data = &mut mem[range];
+    match dir {
+        "seal" => {
+            let tag = key
+                .seal_in_place_separate_tag(nonce, Aad::from(aad), data)
+                .map_err(|e| e.to_string())?;
+            Ok(json!({"tag": base64::encode(tag.as_ref())}))
+        },
+        "open" => {
+            if tag.len() != TAG_LEN {
+                return Err(format!("tag must be {TAG_LEN} bytes"));
+            }
+            let n = data.len();
+            let mut buf = Vec::with_capacity(n + TAG_LEN);
+            buf.extend_from_slice(data);
+            buf.extend_from_slice(&tag);
+            Ok(match key.open_in_place(nonce, Aad::from(aad), &mut buf) {
+                Ok(pt) => {
+                    data.copy_from_slice(pt);
+                    json!(true)
+                },
+                Err(_) => json!(false),
+            })
+        },
+        _ => Err(format!("bad dir {dir}")),
+    }
+}
+
+fn digest_op(args: &JsonValue, mem: &[u8]) -> Res<JsonValue> {
+    let alg = alg_of(args)?;
+    let algorithm = digest_algorithm(alg).ok_or_else(|| format!("unsupported alg {alg}"))?;
+    let data = bytes(args, "data", mem)?;
+    Ok(json!(base64::encode(digest::digest(algorithm, &data))))
+}
+
+fn hmac_op(args: &JsonValue, mem: &[u8]) -> Res<JsonValue> {
+    let alg = alg_of(args)?;
+    let algorithm = hmac_algorithm(alg).ok_or_else(|| format!("unsupported alg {alg}"))?;
+    let (key, data) = (bytes(args, "key", mem)?, bytes(args, "data", mem)?);
+    Ok(json!(base64::encode(hmac::sign(&hmac::Key::new(algorithm, &key), &data))))
+}
+
+/// `Some(reply)` if `op` is one of ours, else `None` (goes to the backend).
+/// `mem` is the guest's linear memory, for `{ptr, len}` byte arguments.
+pub fn sync_op(op: &str, args: &JsonValue, mem: &mut [u8]) -> Option<JsonValue> {
+    let r = match op {
+        "crypto/caps" => {
+            return Some(json!({"ok": {"version": VERSION, "ops": {
+                "verify": SIG_ALGS, "sign": SIG_ALGS, "pubkey": ["ES256", "ES384", "EdDSA"], "aead": AEAD_ALGS,
+                "digest": DIGEST_ALGS, "hmac": DIGEST_ALGS,
+            }}}));
+        },
+        "crypto/verify" => verify(args, mem),
+        "crypto/sign" => sign(args, mem),
+        "crypto/pubkey" => pubkey(args, mem),
+        "crypto/aead" => aead(args, mem),
+        "crypto/digest" => digest_op(args, mem),
+        "crypto/hmac" => hmac_op(args, mem),
+        _ => return None,
+    };
+    Some(match r {
+        Ok(v) => json!({"ok": v}),
+        Err(message) => json!({"error": {"message": format!("{op}: {message}")}}),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const RSA_PUB: &str = "";
+    const RSA_PK8: &str = "";
+    const RSA1024_PUB: &str = "MIGJAoGBAMSDoo62KBGwT4D0wEgugyXd1ke2DjbY0lvQXCDyRNH4+S6lBabwkSfjXaCbAKnpph50sM3so5Mg8CwNPp234nYQR5SgunOvML+3rLerbx4gGFQA3LclvuS6/HLuErcsONAZzl3ESFqw59vqEjuti7bvoghZxoxB0edttp0eR+Z7AgMBAAE=";
+    const P256_PK8: &str = "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg+JRZS0uQ13FS9CMe3MCI4ASDJ9GI2xc76weyKi5wj7mhRANCAAQa1HtqF0NqakogfiUA1qp1wrSmUQTZJU8AA1mi6pcj3AO7fkGYGLMJIVneg5+6rQkLEtVyTd6F90iiIEhg6CdK";
+    const P256_PUB: &str = "BBrUe2oXQ2pqSiB+JQDWqnXCtKZRBNklTwADWaLqlyPcA7t+QZgYswkhWd6Dn7qtCQsS1XJN3oX3SKIgSGDoJ0o=";
+    const P384_PK8: &str = "MIG2AgEAMBAGByqGSM49AgEGBSuBBAAiBIGeMIGbAgEBBDCOB94/r9zGBUFSOCr2O7PHT/JnhRDnfOvX0lsBX+9Rj/9qcyCCsCNIEOB9kj31W4ihZANiAASFA/OJHf67ShBrpnwbUnmg0h30hW6H0GHdvn/4A2tgdR5rVjBE3f/FOMTHGhbSx+Egi3ITTrviKwYV9M13oWEYFgpLB/18XWeKxufV2GmB1CWvgNOpYCQe5hGfBLDiKrU=";
+    const P384_PUB: &str = "BIUD84kd/rtKEGumfBtSeaDSHfSFbofQYd2+f/gDa2B1HmtWMETd/8U4xMcaFtLH4SCLchNOu+IrBhX0zXehYRgWCksH/XxdZ4rG59XYaYHUJa+A06lgJB7mEZ8EsOIqtQ==";
+    const ED_PK8: &str = "MC4CAQAwBQYDK2VwBCIEIMRX6QdDvYJA3o4X4X6s5dhmZ312oTijIeIm/fOIEQHT";
